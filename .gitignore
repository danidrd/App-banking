# --- Java / Maven (budget-app-backend) ---
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
.mvn/timestamp/

# I wrapper di build vanno committati (permettono di buildare senza
# installare Gradle/Maven): eccezione alla regola *.jar qui sopra.
!**/gradle/wrapper/gradle-wrapper.jar

# --- IDE ---
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# --- OS ---
Thumbs.db
.DS_Store

# --- Log ---
*.log

# --- Segreti locali (se in futuro separi le credenziali dall'application.yml) ---
application-local.yml
.env
secrets/

# --- Node / Angular (budget-app-frontend) ---
node_modules/
dist/
.angular/

# --- Android (Capacitor) ---
# La cartella android/ VA committata (ha un suo .gitignore interno per gli
# artefatti di build). Questi invece sono copie generate da `npx cap sync`
# a partire da dist/: rigenerabili sempre, committarle è solo rumore.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json